{
    "extends": "@edx/eslint-config",
    "plugins": [
        "import"
    ],
    "globals": {
        "gettext": true, // added by django for i18n
        "setFixtures": true,  // added globally by jasmine-jquery
        "sinon": true, // used for mocking
        "requirejs": true,
        "define": true,
        "spyOn": true,
        "amd": true,
        "jasmine": true,
        "$": true
    },
    "settings": {
        "import/resolver": "webpack",
        "react": { "version": "18.3" }
    },
    "rules": {
        "import/no-unresolved": ["error", {"amd": true}],
        "import/no-amd": 0,
        "prefer-rest-params": 0,
        "func-names": 0,
        "import/no-extraneous-dependencies": [2, {"devDependencies": true}],
        "import/no-dynamic-require": 0
    },
    "overrides": [
        {
            // Components and widgets of the course list React code are written like micro-frontend code, so they
            // can be copied into the MFE. Everything Insights-specific lives in react/platform/ instead.
            "files": [
                "analytics_dashboard/static/apps/course-list/react/components/**/*.{js,jsx}",
                "analytics_dashboard/static/apps/course-list/react/widgets/**/*.{js,jsx}"
            ],
            "excludedFiles": "**/spec/**",
            "rules": {
                "no-restricted-imports": ["error", {
                    "patterns": ["jquery", "backbone*", "underscore", "utils/*", "components/react/*"]
                }],
                "no-restricted-globals": ["error", "gettext", "ngettext", "$", "jQuery"]
            }
        }
    ]
}
